name: Build and deploy to Cloudflare Workers

on:
  workflow_dispatch:
  push:
    branches:
      - develop
    paths:
      - ".github/workflows/deploy.yml"
      - "/**"

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v3

      - name: Setup Node.js
        uses: actions/setup-node@v3
        with:
          node-version: '18' # or your preferred Node.js version

      - name: Install dependencies
        run: npm install

      - name: Build React App
        run: npm run build

      - name: Install Wrangler
        run: npm install -g wrangler

      - name: Configure Wrangler
        run: |
          echo "${{ secrets.CLOUDFLARE_API_TOKEN }}" > api_token.txt
          wrangler config login --api-token < api_token.txt
          rm api_token.txt

      - name: Deploy to Cloudflare Workers
        env:
          CLOUDFLARE_ACCOUNT_ID: ${{ secrets.REACT_TODO_API_KEY_CF_WORKER }}
        run: wrangler publish --project-name=todo-app --env develop --public --site ./build
      
